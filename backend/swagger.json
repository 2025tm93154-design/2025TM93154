{
  "openapi": "3.0.0",
  "info": {
    "title": "Restaurant Equipment Lending API",
    "description": "API for managing restaurant equipment lending requests with role-based access control",
    "version": "1.0.0",
    "contact": {
      "name": "Restaurant Equipment Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token from login endpoint"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "User ID (MongoDB ObjectId)"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["owner", "manager", "staff"]
          }
        }
      },
      "Equipment": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "Request": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "equipment": {
            "$ref": "#/components/schemas/Equipment"
          },
          "staff": {
            "$ref": "#/components/schemas/User"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "returned"]
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT auth token"
          },
          "role": {
            "type": "string",
            "enum": ["owner", "manager", "staff"]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/users/signup": {
      "post": {
        "summary": "Register a new user",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  },
                  "role": {
                    "type": "string",
                    "enum": ["owner", "manager", "staff"]
                  }
                },
                "required": ["name", "email", "password", "role"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "User registered successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Registration failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "summary": "Login user",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/equipment": {
      "get": {
        "summary": "Get all equipment",
        "tags": ["Equipment"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of all equipment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Equipment"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Add new equipment",
        "tags": ["Equipment"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Owner or Manager only",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "condition": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number"
                  }
                },
                "required": ["name", "category", "condition", "quantity"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Equipment created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Equipment"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "403": {
            "description": "Access denied - Owner or Manager only"
          }
        }
      }
    },
    "/api/equipment/{id}": {
      "put": {
        "summary": "Update equipment",
        "tags": ["Equipment"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Owner or Manager only",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "condition": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Equipment updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Equipment"
                }
              }
            }
          },
          "403": {
            "description": "Access denied"
          }
        }
      },
      "delete": {
        "summary": "Delete equipment",
        "tags": ["Equipment"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Owner only",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Equipment deleted"
          },
          "403": {
            "description": "Access denied - Owner only"
          }
        }
      }
    },
    "/api/requests": {
      "get": {
        "summary": "Get requests",
        "tags": ["Requests"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Owner/Manager see all requests; Staff see only their own",
        "responses": {
          "200": {
            "description": "List of requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Request"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Create equipment request",
        "tags": ["Requests"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Staff only",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "equipment": {
                    "type": "string",
                    "description": "Equipment ID"
                  }
                },
                "required": ["equipment"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          },
          "403": {
            "description": "Access denied - Staff only"
          }
        }
      }
    },
    "/api/requests/{id}": {
      "put": {
        "summary": "Update request status",
        "tags": ["Requests"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Owner or Manager only - approve/reject requests",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["approved", "rejected"]
                  }
                },
                "required": ["status"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          },
          "403": {
            "description": "Access denied"
          }
        }
      }
    },
    "/api/requests/{id}/return": {
      "put": {
        "summary": "Mark request as returned",
        "tags": ["Requests"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Any role - mark approved request as returned",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request marked as returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Users",
      "description": "User authentication endpoints"
    },
    {
      "name": "Equipment",
      "description": "Equipment management endpoints"
    },
    {
      "name": "Requests",
      "description": "Equipment request management endpoints"
    }
  ]
}
